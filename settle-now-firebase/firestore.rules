rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMember(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(uid()));
    }

    // ---- user profiles: private to their owner -------------------------------
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ---- invite codes: readable by any signed-in user (join flow),
    //      created only alongside a room the creator owns ----------------------
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.room_id is string
        && request.resource.data.room_id.size() > 0;
      allow update, delete: if false;
    }

    // ---- rooms ----------------------------------------------------------------
    match /rooms/{roomId} {

      allow read: if signedIn() && isMember(roomId);

      allow create: if signedIn()
        && request.resource.data.created_by == uid()
        && request.resource.data.invite_code is string;

      allow update, delete: if false;

      // ---- membership ---------------------------------------------------------
      match /members/{memberId} {
        allow read: if signedIn();

        // you may add yourself (join-by-code), existing members may add others
        allow create: if signedIn() && (
          memberId == uid() || isMember(roomId)
        );

        // you may leave a room yourself; members may remove others
        allow delete: if signedIn() && (
          memberId == uid() || isMember(roomId)
        );

        allow update: if false;
      }

      // ---- expenses: immutable events ----------------------------------------
      match /expenses/{expenseId} {

        allow read: if signedIn() && isMember(roomId);

        // anti-impersonation: you can only log payments you made yourself;
        // new events always start alive and un-superseded
        allow create: if signedIn() && isMember(roomId)
          && request.resource.data.paid_by == uid()
          && request.resource.data.is_deleted == false
          && (!('superseded_by' in request.resource.data)
              || request.resource.data.superseded_by == null);

        // edits never mutate history — only the supersede/delete flags may change
        allow update: if signedIn() && isMember(roomId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['is_deleted', 'superseded_by']);

        allow delete: if false;
      }

      // ---- settlements ----------------------------------------------------------
      match /settlements/{settlementId} {

        allow read: if signedIn() && isMember(roomId);

        // you can only record settlements that you are paying
        allow create: if signedIn() && isMember(roomId)
          && request.resource.data.from_user == uid();

        allow update, delete: if false;
      }
    }
  }
}
